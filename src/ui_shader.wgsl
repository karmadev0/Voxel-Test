// ui_shader.wgsl
// Shader del overlay 2D (joystick/botones/hotbar táctiles). Las posiciones
// ya vienen calculadas en NDC desde la CPU (ui_overlay.rs) — no hace
// falta ninguna matriz de proyección ni uniform, así que este pipeline no
// tiene bind group.

struct VertexInput {
    @location(0) position: vec2<f32>,
    @location(1) color: vec4<f32>,
};

struct VertexOutput {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) color: vec4<f32>,
};

@vertex
fn vs_main(in: VertexInput) -> VertexOutput {
    var out: VertexOutput;
    out.clip_position = vec4<f32>(in.position, 0.0, 1.0);
    out.color = in.color;
    return out;
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    return in.color;
}
